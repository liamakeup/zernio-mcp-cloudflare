# Upstream Zernio API Key (from https://zernio.com)
ZERNIO_API_KEY=your_zernio_api_key_here

# Optional: Bearer token to protect your Cloudflare Worker endpoint
GATEWAY_TOKEN=your_custom_gateway_secret_token

# Optional: Upstream MCP endpoint (defaults to https://mcp.zernio.com/mcp)
UPSTREAM_MCP_URL=https://mcp.zernio.com/mcp
