# Zernio API key spent by the Worker for callers that present GATEWAY_TOKEN
ZERNIO_API_KEY=your_zernio_api_key_here

# Required whenever ZERNIO_API_KEY is set; without it the Worker never uses its own key
GATEWAY_TOKEN=generate_with_openssl_rand_base64url_32

# Optional: upstream MCP endpoint (defaults to https://mcp.zernio.com/mcp)
UPSTREAM_MCP_URL=https://mcp.zernio.com/mcp
